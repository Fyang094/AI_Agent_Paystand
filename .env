# OpenAI API Key for LLM reasoning
OPENAI_API_KEY=your_openai_api_key_here

# Google Calendar API credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Apple Calendar integration (if needed)
APPLE_CALENDAR_CREDENTIALS=your_apple_credentials

# Health API credentials (Apple Health/Samsung Health)
HEALTH_API_KEY=your_health_api_key

# Database
DATABASE_PATH=./data/schedule.db

# Server configuration
PORT=3000
NODE_ENV=development

# Event search APIs (Eventbrite, Meetup, etc.)
EVENTBRITE_API_KEY=your_eventbrite_key
MEETUP_API_KEY=your_meetup_key
